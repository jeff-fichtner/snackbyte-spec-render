{
  // Type-checking only — this package ships .mjs source, never compiled output. `tsc`
  // (the `typecheck` script) checks the JS via allowJs+checkJs and emits nothing.
  //
  // Deliberately NOT full `strict`: a source-shipped JS package is usually a graft of
  // working code, and forcing JSDoc annotations onto all of it means rewriting it. This
  // profile keeps the checks that catch real defects (undefined variables, bad calls,
  // typos, unreachable code) while tolerating annotation-free JS. See
  // @snackbyte/spec-render's DECISIONS.md §4 for where this profile came from.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.mjs", "test/**/*.mjs"],
  "exclude": ["node_modules", "dist", "coverage"]
}
